---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories';
import { getCollection } from 'astro:content';
const docs = await getCollection('docs');
const recent = [...docs].sort((a, b) => b.data.updated.localeCompare(a.data.updated) || a.data.order - b.data.order).slice(0, 4);
---
<Layout>
  <div class="home-content">
    <div class="breadcrumb"><Icon name="home" size={14} /><Icon name="chevron" size={12} /><span>文档概览</span></div>
    <section class="hero">
      <div class="hero-copy"><div class="eyebrow"><span></span> ALTASCI KNOWLEDGE BASE</div><h1>让知识有序，<br />让每一步<span>更清晰。</span></h1><p>欢迎来到 AltasCI 文档中心。<br />从快速入门到深入实践，在这里找到你需要的答案。</p><div class="hero-actions"><a class="primary-button" href="/docs/business/overview/">开始阅读 <Icon name="arrow" size={17} /></a><button class="secondary-button" data-search-open><Icon name="search" size={16} />搜索文档 <kbd>⌘ K</kbd></button></div><div class="hero-note"><span class="status-dot"></span> 为清晰的思考与高效的协作而构建</div></div>
      <div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-dot dot-one"></div><div class="art-dot dot-two"></div><div class="art-back-card"></div><div class="art-document"><div class="art-doc-head"><span class="art-icon"><Icon name="book" size={23} /></span><span class="art-pill">DOCUMENTATION</span><span class="art-more">•••</span></div><div class="art-title">连接知识，开启可能</div><div class="art-line long"></div><div class="art-line medium"></div><div class="art-doc-rule"></div><div class="art-list"><span><Icon name="check" size={12} /></span><div class="art-line"></div></div><div class="art-list"><span><Icon name="check" size={12} /></span><div class="art-line"></div></div><div class="art-list"><span><Icon name="check" size={12} /></span><div class="art-line short"></div></div><div class="art-doc-bottom"><span class="art-avatars"><i>A</i><i>L</i><i>C</i></span><span>让团队知识触手可及</span></div></div><div class="art-float"><span><Icon name="layers" size={19} /></span><div>井然有序<small>All in one place</small></div><span class="float-check"><Icon name="check" size={14} /></span></div><span class="art-spark">✦</span></div>
    </section>
    <div class="intro-strip"><span><Icon name="spark" size={17} /><strong>第一次来到这里？</strong> 只需几分钟，开启你的文档之旅。</span><a href="/docs/help/quick-start/">快速入门 <Icon name="arrow" size={16} /></a></div>
    <section class="category-section"><div class="section-heading"><div><h2>探索文档</h2><p>按主题浏览，快速找到所需内容</p></div><span class="section-count">{categories.length} 个分类 <span> / </span> {docs.length} 篇文档</span></div><div class="category-grid">{categories.map(category => <a class={`category-card ${category.color}`} href={`/categories/${category.id}/`}><div class="category-top"><span class="category-icon"><Icon name={category.icon} size={23} /></span><span class="card-arrow"><Icon name="arrow" size={18} /></span></div><h3>{category.name}</h3><p>{category.description}</p><div class="category-bottom"><span>{docs.filter(d => d.data.category === category.id).length} 篇文档</span><span>{category.english}</span></div></a>)}</div></section>
    <div class="home-bottom"><section class="recent-section"><div class="section-heading"><div><h2>最近更新 <span class="heading-dot"></span></h2><p>保持同步，发现最新内容</p></div><a class="text-link" href="/docs/reference/changelog/">更新日志 <Icon name="arrow" size={15} /></a></div><div class="recent-list">{recent.map(doc => <a href={`/docs/${doc.id}/`}><span class="recent-file"><Icon name="file" size={18} /></span><div><strong>{doc.data.title}</strong><span>{categories.find(c => c.id === doc.data.category)?.name}</span></div><time datetime={doc.data.updated}>{doc.data.updated.replaceAll('-', '.')}</time><Icon name="chevron" size={14} /></a>)}</div></section><section class="reading-path"><span class="path-eyebrow"><Icon name="rocket" size={17} /> 推荐阅读路径</span><h2>从零开始，循序渐进</h2><p>跟随这条路线，轻松迈出第一步。</p><ol><li><a href="/docs/business/overview/"><span>01</span><div>了解业务流程<small>认识项目、订单与服务交付</small></div><Icon name="chevron" size={14} /></a></li><li><a href="/docs/help/quick-start/"><span>02</span><div>完成首次操作<small>跟随示例创建业务项目</small></div><Icon name="chevron" size={14} /></a></li><li><a href="/docs/pki/overview/"><span>03</span><div>了解证书体系<small>认识 PKI 与证书生命周期</small></div><Icon name="chevron" size={14} /></a></li></ol></section></div>
    <footer class="footer"><span>© {new Date().getFullYear()} AltasCI. 用文档连接每一份知识。</span><span>Built with Astro <span class="footer-star">✦</span></span></footer>
  </div>
</Layout>
